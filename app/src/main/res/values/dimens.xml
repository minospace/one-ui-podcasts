<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Gap between the screen edge and a floating One UI grouped-preference card (Settings). -->
    <dimen name="settings_card_horizontal_margin">16dp</dimen>

    <!-- How tall a list inside a bottom sheet may grow before it starts scrolling, so a long
         Up Next queue caps out instead of pushing the sheet to full screen. -->
    <dimen name="sheet_list_max_height">420dp</dimen>

    <!-- Home-screen widget corner radii. On API 31+ the card radius is overridden in values-v31 to
         the launcher-supplied system_app_widget_background_radius, so the widget's corners match
         every other widget on the home screen (Material You). This is the pre-12 fallback. -->
    <dimen name="widget_card_radius">24dp</dimen>
    <dimen name="widget_art_radius">16dp</dimen>
</resources>
