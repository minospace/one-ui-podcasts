<resources>
    <!-- One UI signature accent blue -->
    <color name="app_primary">#FF0381FE</color>
    <color name="app_on_primary">#FFFFFFFF</color>
    <!-- Material 3 Expressive accent, used in place of app_primary when the user turns on
         "Material You colours" in Settings (see ui/ExpressiveTheme). Everything accent-coloured
         reaches this through ?attr/colorPrimary, which the overlay re-points here; nothing should
         reference app_primary directly, or it would stay blue while the rest of the app moved.

         This default is the M3 baseline primary (tone 40), the fallback for Android 11 and older
         where there is no wallpaper-derived palette. On API 31+ the values-v31/ + values-night-v31/
         variants re-point it at the system tonal palette, the same source the widget already uses. -->
    <color name="app_primary_expressive">#FF6750A4</color>
    <color name="app_divider">#33808080</color>
    <color name="app_art_placeholder">#22808080</color>
    <!-- Semantic alias for the One UI content-panel background (oui_background_color), so app
         code can reach it through the app R class (non-transitive R hides library resources).
         The reference resolves the library's own day/night variant at runtime. -->
    <color name="app_content_background">@color/oui_background_color</color>
    <!-- oneui-design's ToolbarLayout paints its app-bar header and the content card's rounded
         corners directly from these library colour resources (a theme-attribute override has no
         effect — the library reads the resource id, not ?attr/roundedCornerColor). Overriding them
         here (app resources win over the AAR's) collapses the One UI two-tone header/content seam
         into one flat colour. oui_background_color already resolves the right day/night shade, so
         the day and night variants of these can all point at it from this single (default) folder
         — no values-night override needed (and one there with no default declaration trips lint's
         MissingDefaultResource on lintVitalRelease). -->
    <color name="sesl_round_and_bgcolor_light">@color/oui_background_color</color>
    <color name="sesl_round_and_bgcolor_dark">@color/oui_background_color</color>
    <color name="sesl_action_bar_background_color_light">@color/oui_background_color</color>
    <color name="sesl_action_bar_background_color_dark">@color/oui_background_color</color>
    <!-- Mini-player card surface; adapts via the day/night override in values-night. -->
    <color name="app_mini_player_surface">#FFFFFFFF</color>
    <!-- Subtle pill background for the speed / mark-played chips. -->
    <color name="app_chip_surface">#14808080</color>
    <!-- One UI 8.5 grouped-preference card surface, used only on the Settings screen. It sits a
         shade off the flat window background (app_content_background) so each PreferenceCategory
         reads as a discrete rounded card floating on the continuous surface — a lighter card on
         the near-black dark background (values-night), a faint grey card on the near-white light
         background here. This is the newer One UI card look, not the old grey window band the
         "no grey panel" rule removed, so it stays scoped to Settings. -->
    <color name="app_settings_card">#FFF1F1F3</color>

    <!-- Home-screen widget palette. A widget is inflated in the *launcher's* process against the
         launcher's theme, so ?android:attr/textColorPrimary and friends resolve to whatever that
         theme happens to be (often invisible against our own card) — the old widget's washed-out /
         unreadable text. These are concrete, day/night-qualified colours so the widget controls its
         own contrast regardless of the host launcher.

         These (values/ + values-night/) are the pre-Android-12 fallback. On API 31+ the same names
         are re-pointed at the wallpaper-derived Material You tonal palettes in values-v31/ +
         values-night-v31/, so the widget tints itself like Google's own widgets do. The widget goes
         dynamic unconditionally (a launcher-hosted widget can't read the app's theme or settings at
         inflate time), while the *app* is One UI blue unless the user opts in to Material You
         colours in Settings — which is why the widget has its own colour names and its own copies of
         the shared drawables (bg_widget_art, widget_progress, bg_widget_control) rather than sharing
         bg_art_placeholder / mini_progress / bg_round_gray. -->
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_surface_stroke">#33808080</color>
    <color name="widget_text_primary">#FF1A1A1A</color>
    <color name="widget_text_secondary">#8A000000</color>
    <!-- Round container shared by all three transport controls — the widget's copy of the player's
         bg_round_gray, which uses app_chip_surface. -->
    <color name="widget_control_container">#14808080</color>
    <color name="widget_control">#FF1A1A1A</color>
    <!-- Progress fill only; the transport controls are neutral, matching the player. -->
    <color name="widget_accent">@color/app_primary</color>
    <color name="widget_progress_track">#33808080</color>
    <color name="widget_art_placeholder">#22808080</color>
    <color name="widget_icon_muted">#61000000</color>
    <!-- Press feedback for the widget's controls. Not dynamic (and not a ?attr/colorControlHighlight
         reference like bg_round_gray uses, which would resolve against the launcher's theme) —
         just a neutral scrim that works over either an accent-tinted or a plain surface. -->
    <color name="widget_ripple">#1F000000</color>
</resources>
