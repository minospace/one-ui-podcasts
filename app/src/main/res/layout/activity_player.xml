<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oui_background_color">

    <!-- Artwork-derived gradient wash, drawn full-bleed behind the content. -->
    <View
        android:id="@+id/player_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<LinearLayout
    android:id="@+id/player_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="24dp">

    <!-- Everything above the title is a single drag-to-dismiss zone. -->
    <LinearLayout
        android:id="@+id/player_drag_zone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/grabber" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/player_art"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:background="@drawable/bg_art_placeholder"
                android:contentDescription="@null"
                android:elevation="8dp"
                android:scaleType="centerCrop"
                android:transitionName="player_art" />

            <!-- Takes the artwork's place while the user is watching (see PlayerActivity). -->
            <be.miro.onecast.ui.player.VideoFrameLayout
                android:id="@+id/player_video_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/black"
                android:elevation="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextureView
                    android:id="@+id/player_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ProgressBar
                    android:id="@+id/player_video_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </be.miro.onecast.ui.player.VideoFrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/player_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="2"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/player_podcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <!-- Scrolls sideways: a long chapter title next to the video and Up Next chips can outgrow a
         narrow screen. fillViewport keeps the row centred while it still fits. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/player_chapter"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_chapters"
            android:drawablePadding="8dp"
            android:drawableTint="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxWidth="200dp"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="1. Introduction" />

        <Button
            android:id="@+id/player_video_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_video"
            android:drawablePadding="8dp"
            android:drawableTint="?android:attr/textColorPrimary"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/video_show"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/player_up_next"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_queue"
            android:drawablePadding="8dp"
            android:drawableTint="?android:attr/textColorPrimary"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/action_queue"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />
    </LinearLayout>
    </HorizontalScrollView>

    <SeekBar
        android:id="@+id/player_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/player_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/player_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/player_skip_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round_gray"
            android:contentDescription="Skip back 15 seconds"
            android:src="@drawable/ic_skip_back"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/player_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_round_gray"
            android:contentDescription="Play or pause"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_rounded"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/player_skip_forward"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round_gray"
            android:contentDescription="Skip forward 30 seconds"
            android:src="@drawable/ic_skip_forward"
            android:tint="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/player_speed"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:minWidth="84dp"
            android:paddingHorizontal="18dp"
            android:text="1.0×"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/player_mark_played"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_check"
            android:drawablePadding="6dp"
            android:drawableTint="?android:attr/textColorPrimary"
            android:paddingHorizontal="18dp"
            android:text="Mark played"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
</LinearLayout>

    <!--
        Episode notes, parked just off the bottom edge. Scrolling up on the artwork slides the
        player content up by exactly the artwork's height and brings this into the space it
        vacates (see PlayerSheet); its height is set from that same measurement.
        INVISIBLE, not alpha 0, so it doesn't swallow taps meant for the controls underneath.
    -->
    <LinearLayout
        android:id="@+id/player_info"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/player_info_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="10dp"
            android:text="@string/episode_notes"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/player_info_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_info_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="3 days ago · 52 min" />

                <TextView
                    android:id="@+id/player_info_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textColorLink="?attr/colorPrimary"
                    android:textSize="14sp"
                    tools:text="@string/episode_notes_empty" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
