<resources>
    <!-- M3 baseline primary at tone 80 — the dark-scheme counterpart of the tone-40 light value in
         values/colors.xml, so the opt-in accent stays legible on the dark surface. Pre-Android-12
         fallback; API 31+ uses the system palette (values-night-v31). -->
    <color name="app_primary_expressive">#FFD0BCFF</color>

    <!-- Slightly-elevated surface above the near-black One UI dark background. -->
    <color name="app_mini_player_surface">#FF252528</color>
    <color name="app_divider">#33AAAAAA</color>
    <!-- Lighter than the near-black dark window background (#171717) so Settings cards read. -->
    <color name="app_settings_card">#FF242426</color>

    <!-- Dark-mode widget palette (see values/colors.xml for why these are concrete colours, and for
         where the Android 12+ Material You variants live). -->
    <color name="widget_surface">#FF252528</color>
    <color name="widget_surface_stroke">#33AAAAAA</color>
    <color name="widget_text_primary">#FFF3F3F3</color>
    <color name="widget_text_secondary">#99FFFFFF</color>
    <color name="widget_control_container">#1FAAAAAA</color>
    <color name="widget_control">#FFF0F0F0</color>
    <color name="widget_accent">@color/app_primary</color>
    <color name="widget_progress_track">#33AAAAAA</color>
    <color name="widget_art_placeholder">#22AAAAAA</color>
    <color name="widget_icon_muted">#80FFFFFF</color>
    <color name="widget_ripple">#26FFFFFF</color>
</resources>
