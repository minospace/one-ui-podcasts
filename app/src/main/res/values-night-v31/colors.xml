<?xml version="1.0" encoding="utf-8"?>
<!-- Material You (Material 3) widget palette — dark. See values-v31/colors.xml for the rationale.
     Follows the M3 dark scheme: primary = accent1 tone 80 with onPrimary = tone 20 (a light,
     saturated play button carrying a dark glyph), over an accent2 tone 20 surface. -->
<resources>
    <color name="widget_surface">@android:color/system_accent2_800</color>
    <color name="widget_surface_stroke">@android:color/system_accent2_700</color>
    <color name="widget_text_primary">@android:color/system_neutral1_50</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_200</color>
    <color name="widget_control">@android:color/system_accent1_100</color>
    <color name="widget_accent">@android:color/system_accent1_200</color>
    <color name="widget_on_accent">@android:color/system_accent1_800</color>
    <color name="widget_progress_track">@android:color/system_accent2_700</color>
    <color name="widget_art_placeholder">@android:color/system_accent2_700</color>
    <color name="widget_icon_muted">@android:color/system_accent1_400</color>
</resources>
