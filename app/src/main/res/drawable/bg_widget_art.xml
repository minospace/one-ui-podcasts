<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork slot placeholder. A widget-local copy of bg_art_placeholder so the widget can use the
     Material You tinted placeholder without dragging the in-app (One UI) one along with it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_art_placeholder" />
    <corners android:radius="@dimen/widget_art_radius" />
</shape>
