<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-local copy of mini_progress: fully-rounded track + accent fill, drawn from the widget's
     own Material You palette so it doesn't pull the in-app mini-player off One UI blue. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/widget_progress_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="@color/widget_accent" />
            </shape>
        </clip>
    </item>
</layer-list>
