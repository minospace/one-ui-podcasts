<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card the whole widget sits on. Concrete surface + stroke colours (day/night qualified,
     Material You dynamic on API 31+) so it renders identically regardless of the host launcher's
     theme; the radius follows the launcher's own widget radius on API 31+ (see values/dimens.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="@dimen/widget_card_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_surface_stroke" />
</shape>
