<?xml version="1.0" encoding="utf-8"?>
<!-- Borderless circular press feedback for the widget's skip controls, standing in for the
     ?attr/selectableItemBackgroundBorderless the full-screen player uses (a theme attribute would
     resolve against the launcher's theme here). Mask only — the control itself is transparent. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
